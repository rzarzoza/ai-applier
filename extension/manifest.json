{
  "manifest_version": 3,
  "name": "AI Applier",
  "version": "0.1.0",
  "description": "Fills job applications you open with your AI Applier profile and answer bank. Never submits for you.",
  "minimum_chrome_version": "121",
  "permissions": ["storage", "activeTab", "alarms"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "AI Applier", "default_popup": "popup.html" },
  "options_ui": { "page": "popup.html", "open_in_tab": true }
}
